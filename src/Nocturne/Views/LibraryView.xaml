<UserControl x:Class="Nocturne.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Nocturne.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox Style="{StaticResource DarkTextBox}" Height="34" Padding="32,0,30,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Search" FontSize="12" Foreground="#5E5E67"
                           Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="22" Height="22"
                        FontSize="8" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                        Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVis}}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,10,0">
                <ToggleButton Content="All" Style="{StaticResource ChipToggle}"
                              IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{x:Static models:WallpaperFilter.All}" />
                <ToggleButton Content="Videos" Style="{StaticResource ChipToggle}" Margin="4,0,0,0"
                              IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Video, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{x:Static models:WallpaperFilter.Video}" />
                <ToggleButton Content="Images" Style="{StaticResource ChipToggle}" Margin="4,0,0,0"
                              IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Image, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{x:Static models:WallpaperFilter.Image}" />
                <ToggleButton Content="GIFs" Style="{StaticResource ChipToggle}" Margin="4,0,0,0"
                              IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Gif, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{x:Static models:WallpaperFilter.Gif}" />
            </StackPanel>

            <ComboBox Grid.Column="2" Width="130" SelectedValuePath="Tag" SelectedValue="{Binding Sort, Mode=TwoWay}">
                <ComboBoxItem Content="Newest first" Tag="{x:Static models:SortMode.Newest}" />
                <ComboBoxItem Content="Oldest first" Tag="{x:Static models:SortMode.Oldest}" />
                <ComboBoxItem Content="Name (A–Z)" Tag="{x:Static models:SortMode.Name}" />
                <ComboBoxItem Content="Largest first" Tag="{x:Static models:SortMode.Size}" />
            </ComboBox>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel Margin="0,0,0,28">

                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,14"
                        Visibility="{Binding HasActiveCollection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Collection" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveCollectionName}" FontSize="12" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Show all" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ClearCollectionCommand}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Wallpapers}"
                              ItemTemplate="{StaticResource WallpaperCardTemplate}"
                              MouseLeftButtonDown="OnWallpaperDoubleClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty library -->
                <Border Style="{StaticResource SectionCard}" Padding="40" Margin="0,4,0,0"
                        Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Your library is empty" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add MP4, WebM, GIF, PNG or JPG wallpapers. Files are copied into your Nocturne library."
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                        <Button Content="Add wallpapers" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ImportCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- No matches -->
                <Border Style="{StaticResource SectionCard}" Padding="36" Margin="0,4,0,0"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No wallpapers match" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Try a different search, type or collection."
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        <Button Content="Clear filters" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetLibraryFiltersCommand}" HorizontalAlignment="Center"
                                Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
