<UserControl x:Class="Nocturne.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Nocturne.Models">

    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,32" MaxWidth="740" HorizontalAlignment="Left">

            <!-- Engine summary -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnginePaused}" Value="True">
                                            <Setter Property="Fill" Value="#D8A657" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="False">
                                            <Setter Property="Fill" Value="#4A4A52" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding EngineStatus}" FontSize="12" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding EngineDetail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="14,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding TogglePauseCommand}" Margin="0,0,8,0" />
                    <Button Content="Stop" Style="{StaticResource GhostButton}"
                            Command="{Binding StopWallpaperCommand}" />
                </StackPanel>
            </Grid>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"
                      Margin="0,12,0,12">
                <StackPanel>
                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Launch the wallpaper engine when you sign in."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"
                      Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Minimize to tray" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Hide the window instead of keeping a taskbar button."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowNotifications, Mode=TwoWay}">
                <StackPanel>
                    <TextBlock Text="Tray notifications" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Show a short message when Nocturne keeps playing in the background."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <!-- Playback -->
            <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" Margin="0,30,0,0" />
            <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MuteAudio, Mode=TwoWay}"
                      Margin="0,12,0,12">
                <StackPanel>
                    <TextBlock Text="Mute audio" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Live wallpapers are usually best silent. Unmute for soundtracks."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Volume" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Applies to videos with an audio track."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center"
                      IsEnabled="{Binding Settings.MuteAudio, Converter={StaticResource InverseBool}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100"
                            Value="{Binding Settings.Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Settings.VolumeText}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Playback speed" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Slow ambient loops down or speed up motion."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Slider Style="{StaticResource DarkSlider}" Minimum="0.25" Maximum="2"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.PlaybackSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Settings.SpeedText}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Scaling" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="How the source fills a monitor with a different aspect ratio."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                          SelectedValue="{Binding Settings.Scaling, Mode=TwoWay}">
                    <ComboBoxItem Content="Fill — crop to fill" Tag="{x:Static models:WallpaperScale.Fill}" />
                    <ComboBoxItem Content="Fit — show everything" Tag="{x:Static models:WallpaperScale.Fit}" />
                    <ComboBoxItem Content="Stretch — fill and distort" Tag="{x:Static models:WallpaperScale.Stretch}" />
                </ComboBox>
            </Grid>

            <!-- Performance -->
            <TextBlock Text="Performance" Style="{StaticResource SectionTitle}" Margin="0,30,0,0" />
            <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.PauseOnFullscreen, Mode=TwoWay}"
                      Margin="0,12,0,12">
                <StackPanel>
                    <TextBlock Text="Pause when a fullscreen app is active" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Games, video players and presentations get the whole GPU."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.PauseOnBattery, Mode=TwoWay}"
                      Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Pause on battery" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Stop rendering when the laptop is unplugged."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.PauseOnRemoteSession, Mode=TwoWay}">
                <StackPanel>
                    <TextBlock Text="Pause in remote sessions" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Avoid streaming animated wallpaper through Remote Desktop."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
            </CheckBox>

            <!-- Displays -->
            <Grid Margin="0,30,0,0">
                <TextBlock Text="Displays" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <Button Content="Refresh" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding RefreshMonitorsCommand}" />
            </Grid>
            <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />

            <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="72" Height="40" CornerRadius="5" ClipToBounds="True"
                                    Background="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBrush}}">
                                <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="5" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FriendlyName}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Primary" FontSize="9.5" Margin="8,0,0,0"
                                               Foreground="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding WallpaperName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Change" Style="{StaticResource GhostButton}" Padding="10,5"
                                        FontSize="10.5" Margin="0,0,7,0"
                                        Command="{Binding DataContext.ChangeMonitorWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="10,5"
                                        FontSize="10.5"
                                        Command="{Binding DataContext.ClearMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding HasWallpaper}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Library -->
            <TextBlock Text="Library" Style="{StaticResource SectionTitle}" Margin="0,30,0,0" />
            <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Location" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="{Binding LibraryPath}" Style="{StaticResource RowHint}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open folder" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenLibraryFolderCommand}" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Contents" Style="{StaticResource RowTitle}" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                        <Run Text="{Binding LibraryCount, Mode=OneWay}" />
                        <Run Text="wallpapers ·" />
                        <Run Text="{Binding LibrarySizeText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Reset settings" Style="{StaticResource GhostButton}"
                        Command="{Binding ResetSettingsCommand}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Wallpapers are copied into your Nocturne folder, so the originals can move freely. Removing a wallpaper from the library also deletes the copy."
                       Style="{StaticResource RowHint}" Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left" />

            <!-- About -->
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,30,0,18" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" ClipToBounds="True">
                        <Image Source="Assets/icon.png" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Nocturne" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11" Foreground="#4A4A52" Margin="8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VideoEngineText}" Style="{StaticResource MutedText}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open log" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenLogCommand}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
