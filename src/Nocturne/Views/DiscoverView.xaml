<UserControl x:Class="Nocturne.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Nocturne.Models"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,28">

            <!-- Featured -->
            <Border Height="220" CornerRadius="10" ClipToBounds="True"
                    Background="{Binding FeaturedWallpaper.ThumbnailPath, Converter={StaticResource HeroBrush}}"
                    Visibility="{Binding HasFeaturedWallpaper, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Border Background="{StaticResource HeroShade}" />

                    <Grid Margin="22,18">
                        <StackPanel VerticalAlignment="Bottom" MaxWidth="620">
                            <TextBlock Text="{Binding FeaturedWallpaper.Name}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="23" FontWeight="SemiBold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding FeaturedWallpaper.KindLabel}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#C8FFFFFF" />
                                <TextBlock Text="·" FontSize="10" Foreground="#88FFFFFF" Margin="7,0" />
                                <TextBlock Text="{Binding FeaturedWallpaper.SizeText}" FontSize="10"
                                           Foreground="#C8FFFFFF" />
                                <TextBlock Text="·" FontSize="10" Foreground="#88FFFFFF" Margin="7,0" />
                                <TextBlock Text="{Binding FeaturedWallpaper.AddedText}" FontSize="10"
                                           Foreground="#C8FFFFFF" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyCommand}"
                                        CommandParameter="{Binding FeaturedWallpaper}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="White" VerticalAlignment="Center" />
                                        <TextBlock Text="Apply" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding PreviewCommand}"
                                        CommandParameter="{Binding FeaturedWallpaper}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Preview" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Command="{Binding ShuffleCommand}"
                                Background="#59000000">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="Shuffle" Margin="7,0,0,0" Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Empty featured state -->
            <Border Height="220" Style="{StaticResource SectionCard}" Padding="30"
                    Visibility="{Binding HasFeaturedWallpaper, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Nothing to discover yet" FontFamily="{StaticResource DisplayFont}"
                               FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a few wallpapers and Nocturne will surface them here."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    <Button Content="Add wallpapers" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Grid header -->
            <Grid Margin="0,24,0,12">
                <TextBlock Text="More to explore" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="AllChip" Content="All" Tag="All" Style="{StaticResource ChipToggle}"
                                  IsChecked="True" Click="OnFilterClick" />
                    <ToggleButton x:Name="VideoChip" Content="Videos" Tag="Video" Style="{StaticResource ChipToggle}"
                                  Margin="4,0,0,0" Click="OnFilterClick" />
                    <ToggleButton x:Name="ImageChip" Content="Images" Tag="Image" Style="{StaticResource ChipToggle}"
                                  Margin="4,0,0,0" Click="OnFilterClick" />
                    <ToggleButton x:Name="GifChip" Content="GIFs" Tag="Gif" Style="{StaticResource ChipToggle}"
                                  Margin="4,0,0,0" Click="OnFilterClick" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="DiscoverGrid" ItemsSource="{Binding DiscoverWallpapers}"
                          ItemTemplate="{StaticResource WallpaperCardTemplate}"
                          MouseLeftButtonDown="OnWallpaperDoubleClick">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Style="{StaticResource SectionCard}" Padding="24"
                    Visibility="{Binding HasDiscover, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Nothing in this category yet." Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" />
            </Border>

            <TextBlock x:Name="EmptyFilterState" Text="No wallpapers match this filter."
                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
