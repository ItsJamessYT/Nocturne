<Window x:Class="Nocturne.Rendering.WallpaperHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Nocturne.Rendering"
        Title="Nocturne wallpaper"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="False"
        Background="Black"
        Focusable="False"
        Left="-20000"
        Top="-20000"
        Width="320"
        Height="180"
        WindowStartupLocation="Manual">
    <Grid Background="Black">
        <Image x:Name="StaticImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Collapsed" />
        <rendering:VideoSurface x:Name="Surface" />
    </Grid>
</Window>
