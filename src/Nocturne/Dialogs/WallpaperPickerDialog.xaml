<Window x:Class="Nocturne.Dialogs.WallpaperPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturne"
        Icon="pack://application:,,,/Assets/icon.png"
        Width="820"
        Height="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Choose a wallpaper" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" FontFamily="{StaticResource IconFont}" Click="OnCancel" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Height="34"
                             Padding="32,0,10,0" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search wallpapers" FontSize="12"
                               Foreground="#5E5E67" Margin="32,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="CountText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="WallpaperList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnItemDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="7" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#3A3A43" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="196" Height="146" CornerRadius="6" ClipToBounds="True"
                                    Background="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBrush}}">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="56">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#E6000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="10,0,10,8" VerticalAlignment="Bottom"
                                               FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                            Background="#A6000000" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="#E4E1EE" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="30"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No wallpapers match that search." Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="Double-click a wallpaper to apply it immediately." VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="Apply to display" Style="{StaticResource PrimaryButton}" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
