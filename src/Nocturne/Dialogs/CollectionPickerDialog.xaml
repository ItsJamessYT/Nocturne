<Window x:Class="Nocturne.Dialogs.CollectionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturne"
        Icon="pack://application:,,,/Assets/icon.png"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="16" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Add to collection" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        FontFamily="{StaticResource IconFont}" Click="OnCancel" />
            </Grid>

            <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,7,0,14" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />

            <ListBox x:Name="CollectionList" Grid.Row="2" Height="190" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="11,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface3Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBox x:Name="NewNameBox" Style="{StaticResource DarkTextBox}" Height="36"
                         VerticalContentAlignment="Center" />
                <TextBlock x:Name="NewNameHint" Text="Or create a new collection…" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button Content="Remove from collection" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="OnRemove" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
