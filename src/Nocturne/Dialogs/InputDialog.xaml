<Window x:Class="Nocturne.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturne"
        Icon="pack://application:,,,/Assets/icon.png"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="16" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="TitleText" Text="Title" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        FontFamily="{StaticResource IconFont}" Click="OnCancel" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Text="Message" Margin="0,8,0,14"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <TextBox x:Name="ValueBox" Grid.Row="2" Style="{StaticResource DarkTextBox}" Height="36"
                     VerticalContentAlignment="Center" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="OkButton" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
